//==============================================================
// ZigZag "Close only"
// Port of Python detect_zigzag() V1-18
// - ASCII comments
// - No last-branch capture
// - Single loop implementation
// - For backtesting, scan, or Explore

// - Addition of volatility and trend filters
//==============================================================

// General user parameters
seuil_pct = param("ZigZag threshold (%)", 3.5, 0.5 , 5, 0.25);
pctProfitLong = Param("Long take profit threshold", 30, 0.5, 30, 0.5);
pctProfitShort = param("Short take profit threshold", 20, 0.5, 30, 0.25);

// Pullback entry parameters
usePullback = ParamToggle("usePullback", "No|Yes");
pullbackLevel = param("pullbackLevel", 0.1, 0.02, 0.4, 0.02);

// Trend filter user parameters
useTrend = ParamList("useTrend", "Yes|No", 1);
emaDayPeriod = Param("EmaDayPeriod", 20, 3, 50, 1);
CoefEmaDay2 = Param("CoefEmaDay2", 1, 1, 10, 1);
penteEmaDayV = Param("penteEmaDay", -0.5, -2, 2, 0.1);

// -------------------------------------------------------------
// Trend filter
// -------------------------------------------------------------

// Trend daily timeframe variables
TimeFrameSet(inDaily);
EmaDay1 = MA(C, emaDayPeriod);
EmaDay2 = Ref(EmaDay1, (-1) * coefEmaDay2);
TimeFrameRestore();
EmaDay1 = TimeFrameExpand(EmaDay1, inDaily);
EmaDay2 = TimeFrameExpand(EmaDay2, inDaily);
penteEmaDay = (emaDay1 - emaDay2) / emaDay1 * 100;

// We calculate the trend filter

mainTrend = IIf(penteEmaDay > penteEmaDayV, 1, -1);

// -------------------------------------------------------------
// Preparation
// -------------------------------------------------------------

// Need at least 3 bars to detect any movement
if (BarCount < 3)
{
    // Nothing to export
    _exit();
}

// Convert threshold to factor
p = seuil_pct / 100.0;
fProfitLong = pctProfitLong / 100;
fProfitShort = pctProfitShort / 100;

//Trading range variable initialization
bir = status("barInRange");
fbir = status("firstBarInRange");
indexBarre = barIndex();

//Trading variables initialization
Buy = Sell = Short = Cover = 0;

// debug variables
debugPivotIdx = 0;
debugPivotPrice = 0;
debugRetracement = 0;
debugExtremePrice = 0;
debugDuree = 0;

//--------------------------------------------------------------
// Main ZigZag loop
//--------------------------------------------------------------

for (i = 0; i < BarCount; i++)
{
	if ( bir[i] ) //We check that we are in the Range
	{
		price = Close[i];

		if ( fbir[i] ) //If it's the first bar in range, we prepare variables
		{
			firstIndex = indexBarre[i];
			pivotIdx     = 0;
			pivotPrice   = price;
			trend        = 0;    // 0 = unknown, +1 = up, -1 = down
			extremeIdx   = 0;
			extremePrice = pivotPrice;

			inPosition = 0;

			// debug variables
			debugPivotPrice = price;
			debugExtremePrice = pivotPrice;
    	}

		//----------------------------------------------------------
		// Initial trend detection
		//----------------------------------------------------------
		if (trend == 0)
		{
			if (price >= pivotPrice * (1 + p))
			{
				trend = 1;
				extremeIdx = i - firstIndex;
				extremePrice = price;
				debugExtremePrice[i] = extremePrice;
			}
			else
			if (price <= pivotPrice * (1 - p))
			{
				trend = -1;
				extremeIdx = i - firstIndex;
				extremePrice = price;
				debugExtremePrice[i] = extremePrice;
			}
			continue;
		}

		//----------------------------------------------------------
		// Update extreme price and index
		//----------------------------------------------------------
		if (trend == 1 && price > extremePrice)
		{
			extremeIdx = i - firstIndex;
			extremePrice = price;
			debugExtremePrice[i] = extremePrice;
		}
		else
		if (trend == -1 && price < extremePrice)
		{
			extremeIdx = i - firstIndex;
			extremePrice = price;
			debugExtremePrice[i] = extremePrice;
		}

		//----------------------------------------------------------
		// UP trend
		//----------------------------------------------------------

        if (trend == 1)
		{
			// We open a long position if the conditions are met
			if (inPosition == 0)
				if (!usePullback
					AND (useTrend == "No" OR mainTrend[i] == 1))
                {
					Buy[i] = 1;
					inPosition = 1;
					takeProfitPrice = price * (1 + fProfitLong);
				}
				if (usePullback
					AND (useTrend == "No" OR mainTrend[i] == 1))
				{
					// Here we will put the pullback entry code
				}

			// If the take profit is hit, we close the position
            if (price >= takeProfitPrice AND inPosition == 1)
            {
                Sell[i] = 1;
                inPosition = 0;
            }
            
            // Check retracement to validate the branch
            retr = (extremePrice - price) / extremePrice * 100.0;
			debugRetracement[i] = retr;

			if (retr >= seuil_pct)
			{
				amplitude_pct = (extremePrice / pivotPrice - 1.0) * 100.0;
				duree         = extremeIdx - pivotIdx;

                // If we are still in position, we close it
                if (extremePrice < takeProfitPrice AND inPosition == 1)
                {
                    Sell[i] = 1;
                    inPosition = 0;
                }

				// Update debug variable
				debugPivotPrice[i] = price;
				debugPivotIdx[i] = pivotIdx;
				debugDuree[i] = duree;
				debugExtremePrice[i] = price;


				// New pivot becomes former extreme
				pivotIdx   = extremeIdx;
				pivotPrice = extremePrice;

				// Switch trend
				trend        = -1;
				extremeIdx   = i - firstIndex;
				extremePrice = price;

			}
		}
		//----------------------------------------------------------
		// DOWN trend: check rebound to validate the branch
		//----------------------------------------------------------
		else
		{
 			// We open a short position if the conditions are met
			if (inPosition == 0)
				if (!usePullback
					AND (useTrend == "No" OR mainTrend[i] == -1))
                {
					Short[i] = 1;
					inPosition = 1;
					takeProfitPrice = price * (1 - fProfitShort);
				}
				if (usePullback
					AND (useTrend == "No" OR mainTrend[i] == -1))
				{
					// Here we will put the pullback entry code
				}

			// Check if take profit is hit
            if (Price <= takeProfitPrice AND inPosition == 1)
            {
                Cover[i] = 1;
                inPosition = 0;
            }
            
            // Check retracement to validate the branch
			reb = (price - extremePrice) / extremePrice * 100.0;
			debugRetracement[i] = reb;


			if (reb >= seuil_pct)
			{
				amplitude_pct = (1.0 - (extremePrice / pivotPrice)) * 100.0;
				duree         = extremeIdx - pivotIdx;

				
				// Close the present trade?
				if (extremePrice > takeProfitPrice AND inPosition == 1)
				{
					Cover[i] = 1;
					inPosition = 0;
				}

				//Update debug variable
				debugPivotPrice[i] = price;
				debugPivotIdx[i] = pivotIdx;
				debugDuree[i] = duree;
				debugExtremePrice[i] = price;

				// New pivot becomes former extreme
				pivotIdx   = extremeIdx;
				pivotPrice = extremePrice;

				// Switch trend
				trend        = 1;
				extremeIdx   = i - firstIndex;
				extremePrice = price;

			}
		}
	}
}


// Explore columns display
//Filter = 1;

filter = Buy == 1 OR Short == 1 OR Sell == 1 OR Cover == 1;

AddColumn(O, "O");
AddColumn(H, "H");
AddColumn(L, "L");
AddColumn(C, "C");
AddColumn(Buy, "Buy");
AddColumn(Sell,"Sell");
AddColumn(Short, "Short");
AddColumn(Cover, "Cover");

AddColumn(abs(H-L), "abs(h-l)");
AddColumn(debugPivotIdx, "DebugPivotIdx");

AddColumn(penteEmaDay, "penteEmaDay");
AddColumn(mainTrend, "mainTrend");

AddColumn(debugPivotPrice, "DebugPivotPrice");
AddColumn(debugRetracement, "DebugRetracement");
AddColumn(debugExtremePrice, "DebugExtremePrice");
AddColumn(debugDuree, "DebugDuree");