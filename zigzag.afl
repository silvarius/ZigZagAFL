//==============================================================
// ZigZag
// Port of Python detect_zigzag() V1-18
//==============================================================

// We set position size
pctMargin = Param("pctMargin", 100, 1, 100, 1);
SetPositionSize(pctMargin, spsPercentOfEquity);

// General user parameters
seuil_pct = Param("ZigZag threshold (%)", 3, 2 , 10, 0.25);
pctProfitLong = Param("Long take profit threshold", 30, 10, 60, 2);
pctProfitShort = Param("Short take profit threshold", 10, 0.5, 30, 0.25);

// Timeframe parameters
timeFrame = ParamList("timeFrame", "inDaily, inWeekly");
timeFrameVar = iif(timeFrame == "inDaily", inDaily, inWeekly);

// Pullback entry parameters
usePullback = ParamToggle("usePullback", "No|Yes");
pctPullback = Param("Pullback threshold", 0.01, 0.01, 1, 0.01);

// Offset entry parameters.
maxEntryOffset = Param("maxEntryOffset", 1, 1, 5, 1); // this represent the maximum number of candles that can exist between the trend validation point and the entry point

// Trend filter user parameters
useTrend = ParamToggle("useTrend", "No|yes");
useRoc = paramToggle("useRoc", "No|Yes");
rocPeriod = Param("rocPeriod", 9, 1, 20, 1);
emaPeriod = Param("EmaPeriod", 8, 3, 50, 1);
CoefEma2 = Param("CoefEma2", 8, 1, 10, 1); // The number of candles between the 2 EMA points that serve to calculate the EMA slope
penteEmaLongMin = Param("penteEmaLongMin", 1, 0, 5, 0.5);
penteEmaShortMin = Param("penteEmaShortMin", -1, -5, 0, 0.5);
rocThreshold = Param("coefRoc", 1, 1, 10, 1);

// Candle filter parameters
useCandle = ParamToggle("useCandle", "No|Yes");

// Heikin ashi candle parameters
useHaCandle = ParamToggle("useHaCandle", "No|Yes");

// Time filter parameters
useTimeFilter = ParamToggle("useTimeFilter", "No|Yes");

// -------------------------------------------------------------
// Trend filters
// -------------------------------------------------------------

// Trend daily timeframe variables
TimeFrameSet(timeFrameVar);
rocIndicator = Roc(C, rocPeriod);
Ema1 = MA(C, emaPeriod);
Ema2 = Ref(Ema1, (-1) * coefEma2);
TimeFrameRestore();
Ema1 = TimeFrameExpand(Ema1, timeFrameVar);
Ema2 = TimeFrameExpand(Ema2, inWeekly);
rocIndicator = TimeFrameExpand(rocIndicator, timeFrameVar);
penteEma = (ema1 - ema2) / ema1 * 100;

// We calculate the ema trend filter score
EmaTrendScore = IIf(penteEma > penteEmaLongMin, 1, IIF(penteEma < penteEmaShortMin, -1, 0));

// We calculate the roc trend filter scores
rocLong = rocIndicator >= rocThreshold;
rocShort = rocIndicator <= -rocThreshold;


// ---------------------------------------------------------------
// Candle filter
// ---------------------------------------------------------------

// We want to check if the previous candle on the weekly timeframe was green or red
TimeFrameSet(inWeekly);
candleColor = iif(ref(C, -1) - ref(O, -1) >= 0, colorGreen, iif(ref(C, -1) - ref(O, -1) < 0, colorRed, 0));
TimeFrameRestore();
candleColor = TimeFrameExpand(candleColor, inWeekly);

// ---------------------------------------------------------------
// Heikin Ashi candle filter
// ---------------------------------------------------------------

// We build the OHLC Heikin Ashi candles values and look at the previous one color
TimeFrameSet (inWeekly);
	haO = (ref(O, -1) + ref(C, -1)) / 2;
	haC = (O + H + L + C) / 4;
	haColor = iif(haC >= haO, colorGreen, colorRed);
	previousHaColor = ref(haColor, -1);
TimeFrameRestore();
previousHaColor = TimeFrameExpand(previousHaColor, InWeekly);

// --------------------------------------------------------------
// Time filter
// --------------------------------------------------------------

timeFilter = dayOfWeek() != 6 AND dayOfWeek() != 5; // We don't enter position on weekEnds

// ---------------------------------------------------------------
// Filters merge
// ---------------------------------------------------------------

// We initialize the filter variables
filterLong = True;
filterShort = True;

// We merge first the Ema trend filter
if (useTrend)
{
	filterLong = EmaTrendScore == 1;
	filterShort = EmaTrendScore == -1;
}

// We then merge the roc trend filter
if (useRoc)
{
	filterLong = filterLong AND rocLong;
	filterShort = filterShort AND rocShort;
}

// We then merge the candle filter
if (useCandle)
{
	filterLong = filterLong AND candleColor == colorGreen;
	filterShort = filterShort AND candleColor == colorRed;
}

// we then merge the heikin ashi candle filter
if (useHaCandle)
{
	filterLong = filterLong AND previousHaColor == colorGreen;
	filterShort = filterShort AND previousHaColor == colorRed;
}

// We then merge the time filter
if (useTimeFilter)
{
	filterLong = filterLong AND timeFilter;
	filterShort = filterShort AND timeFilter;
}

// -------------------------------------------------------------
// Preparation
// -------------------------------------------------------------

// Need at least 3 bars to detect any movement
if (BarCount < 3)
{
    // Nothing to export
    _exit();
}

// Convert threshold to factor
p = seuil_pct / 100.0;
fProfitLong = pctProfitLong / 100;
fProfitShort = pctProfitShort / 100;
fPullback = pctPullback / 100;

//Trading range variable initialization
bir = status("barInRange");
fbir = status("firstBarInRange");
indexBarre = barIndex();

//Trading variables initialization
Buy = Sell = Short = Cover = 0;

// debug variables
debugPivotIdx = 0;
debugPivotPrice = 0;
debugRetracement = 0;
debugExtremePrice = 0;
debugDuree = 0;

//--------------------------------------------------------------
// Main ZigZag loop
//--------------------------------------------------------------

for (i = 0; i < BarCount; i++)
{
	if ( bir[i] ) //We check that we are in the Range
	{
		price = Close[i];

		if ( fbir[i] ) //If it's the first bar in range, we prepare variables
		{
			firstIndex = indexBarre[i];
			pivotIdx     = 0;
			pivotPrice   = price;
			trend        = 0;    // 0 = unknown, +1 = up, -1 = down
			extremeIdx   = 0;
			extremePrice = pivotPrice;

			inPosition = 0;

			// debug variables
			debugPivotPrice = price;
			debugExtremePrice = pivotPrice;
    	}

		//----------------------------------------------------------
		// Initial trend detection
		//----------------------------------------------------------
		if (trend == 0)
		{
			if (price >= pivotPrice * (1 + p))
			{
				trend = 1;
				TrendValidationIndex = i - firstIndex;
				extremeIdx = i - firstIndex;
				extremePrice = price;
				debugExtremePrice[i] = extremePrice;
			}
			else
			if (price <= pivotPrice * (1 - p))
			{
				trend = -1;
				TrendValidationIndex = i - firstIndex;
				extremeIdx = i - firstIndex;
				extremePrice = price;
				debugExtremePrice[i] = extremePrice;
			}
			continue;
		}

		//----------------------------------------------------------
		// Update extreme price and index
		//----------------------------------------------------------
		if (trend == 1 && price > extremePrice)
		{
			extremeIdx = i - firstIndex;
			extremePrice = price;
			debugExtremePrice[i] = extremePrice;
		}
		else
		if (trend == -1 && price < extremePrice)
		{
			extremeIdx = i - firstIndex;
			extremePrice = price;
			debugExtremePrice[i] = extremePrice;
		}

		//----------------------------------------------------------
		// UP trend
		//----------------------------------------------------------

        if (trend == 1)
		{         
            // Check retracement to validate a potential new branch
            retr = (extremePrice - price) / extremePrice * 100.0;
			debugRetracement[i] = retr;

			if (retr >= seuil_pct)
			{
				amplitude_pct = (extremePrice / pivotPrice - 1.0) * 100.0;
				duree         = extremeIdx - pivotIdx;

                // If we are still in position, we close it
                if (inPosition == 1)
                {
                    if (extremePrice < takeProfitPrice)
					{
						Sell[i] = 1;
						inPosition = 0;
					}
				}

				// Update debug variable
				debugPivotPrice[i] = price;
				debugPivotIdx[i] = pivotIdx;
				debugDuree[i] = duree;
				debugExtremePrice[i] = price;


				// New pivot becomes former extreme
				pivotIdx   = extremeIdx;
				pivotPrice = extremePrice;

				// Switch trend
				trend        = -1;
				trendValidationIndex = i - firstIndex; // The index when the trend was validated. We will use it for the position entering max offset.
				extremeIdx   = i - firstIndex;
				extremePrice = price;

				// If a new branch has been validated, we moved directly to the next candle
				continue;
			}

			// We open a long position if the conditions are met

			// We first check if we are within the max position offset range
			if (i - firstIndex <= trendValidationIndex + maxEntryOffset)
			{
				withinOffset = True;
			}
			else
			{
				withinOffset = False;
			}

			if (inPosition == 0 AND withinOffset)
			{	
				// If we don't use pullback, we enter in the candle that follows the new trend detection;
				if (!usePullback AND filterLong[i])
				{
					Buy[i] = 1;
					inPosition = 1;
					takeProfitPrice = price * (1 + fProfitLong);
				}
				// If we use pullback, we enter only if the candle Low is strictly inferior to the new trend validation price - pullback %
				if (usePullback AND filterLong[i])
				{
					pullbackLevel = pivotPrice * (1 + p) * (1 - fPullback);

					if (L[i] < pullbackLevel)
					{
						Buy[i] = 1;
						BuyPrice[i] = pullbackLevel;
						inPosition = 1;
						takeProfitPrice = pivotPrice * (1 + p) * (1 + fProfitLong);
					}
				}
			}

			// If the take profit is hit, we close the position
            if (inPosition == 1)
            {
                if (price >= takeProfitPrice)
				{
					Sell[i] = 1;
					SellPrice[i] = takeProfitPrice;
                	inPosition = 0;
				}
            }
		}

		//----------------------------------------------------------
		// DOWN trend: check rebound to validate the branch
		//----------------------------------------------------------
		
		else
		{
            
            // Check retracement to validate a potential new branch
			reb = (price - extremePrice) / extremePrice * 100.0;
			debugRetracement[i] = reb;

			if (reb >= seuil_pct)
			{
				amplitude_pct = (1.0 - (extremePrice / pivotPrice)) * 100.0;
				duree         = extremeIdx - pivotIdx;

				// If we are still in position, we close it
				if (inPosition == 1)
				{
					if (extremePrice > takeProfitPrice)
					{
						Cover[i] = 1;
						inPosition = 0;
					}
				}

				//Update debug variable
				debugPivotPrice[i] = price;
				debugPivotIdx[i] = pivotIdx;
				debugDuree[i] = duree;
				debugExtremePrice[i] = price;

				// New pivot becomes former extreme
				pivotIdx   = extremeIdx;
				pivotPrice = extremePrice;

				// Switch trend
				trend        = 1;
				trendValidationIndex = i - firstIndex; // The index when the trend was validated. We will use it for the position entering max offset.
				extremeIdx   = i - firstIndex;
				extremePrice = price;

				// If a new branch has been validated, we moved directly to the next candle
				continue;
			}

			// We open a short position if the conditions are met

			// We first check if we are within the max position offset range
			if (i - firstIndex <= trendValidationIndex + maxEntryOffset)
			{
				withinOffset = True;
			}
			else
			{
				withinOffset = False;
			}

			if (inPosition == 0 AND withinOffset)
			{	
				if (!usePullback AND filterShort[i])
                {
					Short[i] = 1;
					inPosition = 1;
					takeProfitPrice = price * (1 - fProfitShort);
				}

				if (usePullback AND filterShort[i])
				{
					pullbackLevel = pivotPrice * (1 - p) * (1 + fPullback);

					if (H[i] > pullbackLevel)
					{
						Short[i] = 1;
						ShortPrice[i] = pullbackLevel;
						inPosition = 1;
						takeProfitPrice = pivotPrice * (1 - p) * (1 - fProfitShort);
					}
				}
			}
			
			// Check if take profit is hit
            if (inPosition == 1)
            {
                if (Price <= takeProfitPrice)
				{
					Cover[i] = 1;
					CoverPrice[i] = takeProfitPrice;
                	inPosition = 0;
				}
            }
		}
	}
}

// Explore columns display
//Filter = 1;

filter = Buy == 1 OR Short == 1 OR Sell == 1 OR Cover == 1;

AddColumn(O, "O");
AddColumn(H, "H");
AddColumn(L, "L");
AddColumn(C, "C");
AddColumn(Buy, "Buy");
AddColumn(Sell,"Sell");
AddColumn(Short, "Short");
AddColumn(Cover, "Cover");

AddColumn(abs(H-L), "abs(h-l)");
AddColumn(debugPivotIdx, "DebugPivotIdx");

AddColumn(penteEma, "PenteEma");
AddColumn(penteEmaLongMin, "penteEmaLongMin");
AddColumn(penteEmaShortMin, "penteEmaShortMin");
AddColumn(EmaTrendScore, "EmaTrendScore");

AddColumn(rocIndicator, "rocIndicator");
AddColumn(rocLong, "rocLong");
AddColumn(rocShort, "rocShort");

AddColumn(debugPivotPrice, "DebugPivotPrice");
AddColumn(debugRetracement, "DebugRetracement");
AddColumn(debugExtremePrice, "DebugExtremePrice");
AddColumn(debugDuree, "DebugDuree");